{
  "name": "@soydachi/pipeline-assistant-mcp",
  "version": "1.0.0",
  "description": "MCP server for intelligent CI/CD pipeline assistance with generative AI",
  "main": "dist/server.js",
  "type": "module",
  "bin": {
    "pipeline-assistant": "./dist/cli/pipeline-assistant.js",
    "pipeline-wiki": "./dist/cli/wiki-cli.js",
    "pipeline-pr": "./dist/cli/pr-bot-cli.js"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "dev": "tsc --watch",
    "start": "node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "npm run build"
  },
  "mcp": {
    "server": {
      "command": "node",
      "args": [
        "dist/server.js"
      ],
      "transport": "stdio"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soydachi/pipeline-assistant-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "pipeline",
    "cicd",
    "devsecops",
    "azure-devops",
    "github-actions",
    "ai",
    "generative-ai",
    "automation"
  ],
  "author": {
    "name": "Dachi Gogotchuri",
    "email": "dachi.gogotchuri@gmail.com",
    "url": "https://soydachi.com"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/soydachi/pipeline-assistant-mcp/issues"
  },
  "homepage": "https://github.com/soydachi/pipeline-assistant-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "@octokit/rest": "^20.0.0",
    "yaml": "^2.3.0",
    "glob": "^10.3.10",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "cli-table3": "^0.6.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/jest": "^29.5.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}
