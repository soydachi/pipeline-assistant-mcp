{
  "name": "@company/pipeline-assistant-mcp",
  "version": "1.0.0",
  "description": "MCP server for intelligent CI/CD pipeline assistance",
  "main": "dist/server.js",
  "type": "module",
  "bin": {
    "pipeline-assistant": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "dev:next": "node scripts/next-scenario.js",
    "progress:update": "node scripts/update-progress.js"
  },
  "mcp": {
    "server": {
      "command": "node",
      "args": ["dist/server.js"],
      "transport": "stdio"
    }
  },
  "keywords": ["mcp", "pipeline", "cicd", "azure-devops", "github-actions"],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "yaml": "^2.3.0",
    "glob": "^10.3.10",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/jest": "^29.5.0",
    "typescript": "^5.3.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0"
  }
}
